{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fidus-staging",
  "main": "src/cf/fidus.ts",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fidus-staging-db",
      "database_id": "19d312d4-f467-4908-877d-a6fb2dc10ab2"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCUMENTS",
      "bucket_name": "fidus-documents"
    }
  ],
  "vars": {
    "NODE_ENV": "production",
    "EMAIL_FROM": "Fidus Medical Center <noreply@fidusmedicals.space>",
    "SUPPORT_EMAIL": "consult@fidusmedicals.space",
    "APP_URL": "https://fidus-staging.aidomexgroupltd.workers.dev",
    "FRONTEND_URL": "https://fidus-staging.aidomexgroupltd.workers.dev",
    "BACKEND_URL": "https://fidus-staging.aidomexgroupltd.workers.dev"
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "directory": "dist"
  },
  "env": {
    "production": {
      "name": "fidusmedials",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "fidusmedicals.space",
          "custom_domain": true
        },
        {
          "pattern": "www.fidusmedicals.space",
          "custom_domain": true
        }
      ],
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "fidusmeduals-prod",
          "database_id": "1f66c7a8-cc0e-45ac-acc8-317993db80a6"
        }
      ],
      "r2_buckets": [
        {
          "binding": "DOCUMENTS",
          "bucket_name": "fidus-documents-prod"
        }
      ],
      "vars": {
        "NODE_ENV": "production",
        "EMAIL_FROM": "Fidus Medical Center <noreply@fidusmedicals.space>",
        "SUPPORT_EMAIL": "consult@fidusmedicals.space",
        "APP_URL": "https://fidusmedicals.space",
        "FRONTEND_URL": "https://fidusmedicals.space",
        "BACKEND_URL": "https://fidusmedicals.space"
      },
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "directory": "dist"
      },
      "triggers": {
        "crons": [
          "*/5 * * * *"
        ]
      }
    }
  },
  "triggers": {
    "crons": [
      "*/5 * * * *"
    ]
  }
}
